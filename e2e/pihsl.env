# Sierra Leone (KGH). Copy this file to .env (which is not committed) and set the server and the user. Only the lines marked "set" are yours to change: the
# rest is the metadata of the Sierra Leone configuration, the same on every server of it.

# set: the server to test. Use a server with TEST DATA ONLY: the tests create synthetic patients ("AutoE Tester", ...) and void them afterwards.
E2E_BASE_URL=https://kgh-ci.pih-emr.org/openmrs
# set: a user that may create and void patients, visits and encounters over REST
E2E_USER_ADMIN_USERNAME=admin
E2E_USER_ADMIN_PASSWORD=Admin123
# set: the provider the forms select; when it is not listed on a form the first provider is chosen. Quote values that contain spaces.
E2E_DEFAULT_PROVIDER_NAME="Super User"

# "KGH EMR ID" and "KGH Primary Identifier Source" (a server-issued, sequential "KGH<number>")
E2E_PATIENT_IDENTIFIER_TYPE_UUID=c09a1d24-7162-11eb-8aa6-0242ac110002
E2E_PATIENT_IDENTIFIER_SOURCE_UUID=809b23e3-7162-11eb-8aa6-0242ac110002
# Visits at KGH; the session location is MCH OPD
E2E_VISIT_LOCATION_UUID=074b2ab0-716a-11eb-8aa6-0242ac110002
E2E_SESSION_LOCATION_UUID=5981f962-6eec-453d-89ce-2f9ac48d096f

# Optional: a slow server needs longer timeouts: this multiplies them (30 s per test, 15 s per check). Try 3 for a local server.
# E2E_TIMEOUT_FACTOR=3
