# Haiti (ZL). Copy this file to .env (which is not committed) and set the server and the user. Only the lines marked "set" are yours to change: the
# rest is the metadata of the ZL configuration, the same on every ZL server.

# set: the server to test. Use a server with TEST DATA ONLY: the tests create synthetic patients ("AutoE Tester", ...) and void them afterwards.
E2E_BASE_URL=http://zl-ci.pih-emr.org/openmrs
# set: a user that may create and void patients, visits and encounters over REST
E2E_USER_ADMIN_USERNAME=admin
E2E_USER_ADMIN_PASSWORD=Admin123
# set: the provider the forms select; when it is not listed on a form the first provider is chosen. Quote values that contain spaces.
E2E_DEFAULT_PROVIDER_NAME="Super User"

# "ZL EMR ID" and "Local Pool of ZL Identifiers", the pool that registration draws from (a server-issued identifier, with its Luhn mod 30 check digit)
E2E_PATIENT_IDENTIFIER_TYPE_UUID=a541af1e-105c-40bf-b345-ba1fd6a59b85
E2E_PATIENT_IDENTIFIER_SOURCE_UUID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
# Visits at Mirebalais (UHM); the session location is Klinik Ekstèn
E2E_VISIT_LOCATION_UUID=a084f714-a536-473b-94e6-ec317b152b43
E2E_SESSION_LOCATION_UUID=199e7d87-92a0-4398-a0f8-11d012178164
E2E_MIN_REGISTRATION_LOCATIONS=5

# Optional: a slow server needs longer timeouts: this multiplies them (30 s per test, 15 s per check). Try 3 for a local server.
# E2E_TIMEOUT_FACTOR=3
